# Copy this file to .env.smoke. These values are local-only examples, not production secrets.
NODE_ENV=production
PORT=3001

POSTGRES_DB=fashion_ais_smoke
POSTGRES_USER=fashion_ais_smoke
POSTGRES_PASSWORD=local-smoke-postgres-password
DATABASE_URL=postgresql://fashion_ais_smoke:local-smoke-postgres-password@postgres:5432/fashion_ais_smoke?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=local-smoke-redis-password

JWT_ACCESS_SECRET=local-smoke-access-secret-change-me-000000000000
JWT_REFRESH_SECRET=local-smoke-refresh-secret-change-me-00000000000
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGINS=https://localhost:8443,https://localhost:8444
TRUST_PROXY=1
LOG_LEVEL=info

# Mock providers prevent paid external AI calls.
AI_DEFAULT_PROVIDER=mock
AI_IMAGE_GENERATION_PROVIDER=mock
AI_VIRTUAL_TRY_ON_PROVIDER=mock
AI_IMAGE_EDITING_PROVIDER=mock
MOCK_AI_DELAY_MS=100

# Worker transport satisfies production validation without embedding real credentials.
# Replace these local placeholders in .env.smoke if testing an existing R2 gateway.
R2_TRANSPORT=worker
R2_BUCKET=fashionais-smoke
R2_GATEWAY_BASE_URL=https://example.invalid
R2_GATEWAY_SIGNING_SECRET=local-smoke-r2-signing-secret-change-me-000000

# Stripe is disabled when its secret and price IDs are empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://localhost:8443/billing/success
STRIPE_CANCEL_URL=https://localhost:8443/pricing
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_TOPUP_100=
STRIPE_PRICE_TOPUP_500=
STRIPE_PRICE_TOPUP_1000=
STRIPE_PRICE_TOPUP_5000=
